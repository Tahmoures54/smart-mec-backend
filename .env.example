# Smart-MEC Backend — Environment Variables (EXAMPLE)
# Never put real secrets in this file or commit them.
# Production values belong in Liara Environment Variables.

APP_URL=https://smart-mec.ir
NODE_ENV=production

# Auth
JWT_SECRET=
COOKIE_SECRET=
ADMIN_SYSTEM_TOKEN=

# Admin
ADMIN_PHONE=09160684552
ADMIN_BYPASS_CODE=
UNIVERSAL_BYPASS_CODE=

# Database
# Current backend uses SQLite at DATABASE_PATH.
# DATABASE_URL is intentionally unused by the current DB implementation.
DATABASE_PATH=/app/db/sqlite.db

# SMS — Kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=smartmechanicregister
SHOW_OTP_IN_DEV=false

# AI — OpenAI-compatible DeepSeek provider
# Keep the endpoint supplied by your API vendor if you purchased a proxied API.
DEEPSEEK_API_KEY=
DEEPSEEK_API_ENDPOINT=https://api.avalai.ir/v1
# Set this to a model actually supported by your provider.
DEEPSEEK_MODEL=deepseek-chat

# AI latency limits
AI_TIMEOUT_MS=30000
AI_MAX_TOKENS=1200

# Payment — Zibal
ZIBAL_MERCHANT_ID=
ZIBAL_API_KEY=
ZIBAL_SANDBOX=false
ZIBAL_GATEWAY_URL=https://gateway.zibal.ir
ZIBAL_REQUEST_URL=https://gateway.zibal.ir/v1/request
ZIBAL_VERIFY_URL=https://gateway.zibal.ir/v1/verify
ZIBAL_START_URL=https://gateway.zibal.ir/start
ZIBAL_TIMEOUT_MS=15000

# Business
REFERRAL_PERCENTAGE=10
MIN_WITHDRAWAL=50000
MONTHLY_FREE_LIMIT=2
BLUE_TICK_DAYS=30

# CORS — production only
ALLOWED_ORIGINS=https://smart-mec.ir,https://www.smart-mec.ir

# App download
NEXT_PUBLIC_APK_URL=
NEXT_PUBLIC_CAFEBAZAAR_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
