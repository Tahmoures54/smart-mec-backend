# ═══════════════════════════════════════════════════════════
# Smart-MEC Backend — Environment Variables (EXAMPLE)
# کپی کنید:  cp .env.example .env
# مقادیر واقعی را فقط در .env محلی یا Vercel Environment Variables بگذارید.
# هرگز .env را commit نکنید.
# ═══════════════════════════════════════════════════════════

APP_URL=https://smart-mec-backend-zeta.vercel.app
NODE_ENV=production
VERCEL=1

# ── Auth (رشته‌های تصادفی و قوی بسازید) ──
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECRET=change-me-too
ADMIN_SYSTEM_TOKEN=change-me-admin-token

# ── Admin ──
ADMIN_PHONE=09160684552
ADMIN_BYPASS_CODE=
UNIVERSAL_BYPASS_CODE=

# ── Database ──
# Vercel + Neon / Postgres:
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# یا Turso:
# TURSO_DATABASE_URL=libsql://YOUR-DB-NAME-ORG.turso.io
# TURSO_AUTH_TOKEN=
# Local SQLite:
# DATABASE_URL=file:./app.db

# ── SMS — Kavenegar ──
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=verify
SHOW_OTP_IN_DEV=false

# ── AI (DeepSeek / AvalAI) ──
DEEPSEEK_API_KEY=
DEEPSEEK_API_ENDPOINT=https://api.avalai.ir/v1
DEEPSEEK_MODEL=deepseek-chat
AI_TIMEOUT_MS=35000

# ── Payment — PayPing ──
PAYPING_TOKEN=

# ── Business ──
REFERRAL_PERCENTAGE=10
MIN_WITHDRAWAL=50000
BLUE_TICK_DAYS=30

# ── CORS (با کاما جدا کنید) ──
# برای اپ موبایل Origin معمولاً مهم نیست؛ برای وب ادمین دامنه را اضافه کنید
ALLOWED_ORIGINS=https://smart-mec-backend-zeta.vercel.app,https://www.smart-mec.ir,http://localhost:3000
