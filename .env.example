# ═══════════════════════════════════════════════════════════
# Smart-MEC Backend — Environment Variables (EXAMPLE)
# کپی کنید:  cp .env.example .env
# مقادیر واقعی را فقط در .env محلی یا Liara / Vercel بگذارید.
# هرگز .env را commit نکنید.
# ═══════════════════════════════════════════════════════════

APP_URL=https://smart-mec.ir
NODE_ENV=development

# ── Auth (رشته‌های تصادفی و قوی بسازید) ──
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECRET=change-me-too
ADMIN_SYSTEM_TOKEN=change-me-admin-token

# ── Admin ──
ADMIN_PHONE=09160684552
ADMIN_BYPASS_CODE=
UNIVERSAL_BYPASS_CODE=

# ── Database (Neon / Postgres) ──
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# ── SMS — Kavenegar ──
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=verify
# اگر true باشد، OTP در پاسخ send برمی‌گردد (فقط توسعه)
SHOW_OTP_IN_DEV=true

# ── AI (DeepSeek / AvalAI) ──
DEEPSEEK_API_KEY=
DEEPSEEK_API_ENDPOINT=https://api.avalai.ir/v1
DEEPSEEK_MODEL=deepseek-chat
AI_TIMEOUT_MS=35000
AI_MAX_TOKENS=4000

# ── Payment — Zibal ──
# کد مرچنت زیبال از پنل کاربری: https://zibal.ir
# برای حالت تست (Sandbox) مقدار zibal را قرار دهید.
# خالی = پرداخت آزمایشی محلی (MOCK)
# توجه: مبلغ ارسالی به زیبال بر حسب ریال است (×۱۰ از تومان).
ZIBAL_MERCHANT=
ZIBAL_REQUEST_URL=https://gateway.zibal.ir/v1/request
ZIBAL_VERIFY_URL=https://gateway.zibal.ir/v1/verify
ZIBAL_START_URL=https://gateway.zibal.ir/start
ZIBAL_TIMEOUT_MS=15000

# ── Business ──
REFERRAL_PERCENTAGE=10
MIN_WITHDRAWAL=50000
MONTHLY_FREE_LIMIT=2
BLUE_TICK_DAYS=30

# ── CORS (با کاما جدا کنید) ──
ALLOWED_ORIGINS=https://smart-mec.ir,https://www.smart-mec.ir,https://smart-mec.liara.run,http://localhost:3000

# ── صفحه اصلی / دانلود اپ ──
# اگر خالی باشد، فایل public/downloads/smart-mec.apk سرو می‌شود.
NEXT_PUBLIC_APK_URL=
# وقتی اپ در فروشگاه منتشر شد، لینک کامل را بگذارید تا دکمه فعال شود.
NEXT_PUBLIC_CAFEBAZAAR_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
