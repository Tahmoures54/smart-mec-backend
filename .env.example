# ═══════════════════════════════════════════════════════════
# Smart-MEC Backend — Environment Variables (EXAMPLE)
# Copy to .env and fill real values. NEVER commit .env
# ═══════════════════════════════════════════════════════════

APP_URL=https://your-domain.com
HOST=0.0.0.0
PORT=3000
NODE_ENV=production

# Auth (generate strong random strings)
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECRET=change-me-too
ADMIN_SYSTEM_TOKEN=change-me-admin-token

# Admin bypass (optional — leave empty in production if unused)
ADMIN_PHONE=
ADMIN_BYPASS_CODE=
# UNIVERSAL_BYPASS_CODE should be empty or removed in production
UNIVERSAL_BYPASS_CODE=

# Database (Liara path example)
DATABASE_URL=file:/app/data/app.db
DB_PATH=/app/data/app.db
DB_DIR=/app/data
AUTO_BACKUP=true
BACKUP_ON_SHUTDOWN=true

# SMS — Kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=verify
SHOW_OTP_IN_DEV=false

# AI (DeepSeek via AvalAI or official)
DEEPSEEK_API_KEY=
DEEPSEEK_API_ENDPOINT=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
AI_TIMEOUT_MS=35000

# Payment — PayPing
PAYPING_TOKEN=

# Business
REFERRAL_PERCENTAGE=10
MIN_WITHDRAWAL=50000

# CORS (comma-separated)
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com,http://localhost:3000
