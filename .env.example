# ═══════════════════════════════════════════════════════════
# Smart-MEC Backend — Environment Variables (EXAMPLE)
# Copy to .env and fill real values. NEVER commit .env
# ═══════════════════════════════════════════════════════════

APP_URL=https://your-project.vercel.app
NODE_ENV=production

# Auth (generate strong random strings)
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECRET=change-me-too
ADMIN_SYSTEM_TOKEN=change-me-admin-token

# Admin
ADMIN_PHONE=09160684552
ADMIN_BYPASS_CODE=
UNIVERSAL_BYPASS_CODE=

# ── Database ──
# Local: file:./app.db
# Vercel/Turso: libsql://YOUR-DB-NAME-ORG.turso.io
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=
# fallback local
DATABASE_URL=file:./app.db

# SMS — Kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=verify
SHOW_OTP_IN_DEV=false

# AI (DeepSeek via AvalAI or official)
DEEPSEEK_API_KEY=
DEEPSEEK_API_ENDPOINT=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
AI_TIMEOUT_MS=35000

# Payment — PayPing
PAYPING_TOKEN=

# Business
REFERRAL_PERCENTAGE=10
MIN_WITHDRAWAL=50000

# CORS (comma-separated) — include Vercel domain
ALLOWED_ORIGINS=https://your-project.vercel.app,http://localhost:3000
