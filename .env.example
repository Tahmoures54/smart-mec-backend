# ═══════════════════════════════════════════════════════════
# Smart-MEC Backend — Environment Variables (EXAMPLE)
# کپی کنید:  cp .env.example .env
# مقادیر واقعی را فقط در .env محلی یا Vercel / Liara بگذارید.
# هرگز .env را commit نکنید.
# ═══════════════════════════════════════════════════════════

APP_URL=https://smart-mec-backend-zeta.vercel.app
NODE_ENV=development

# ── Auth (رشته‌های تصادفی و قوی بسازید) ──
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECRET=change-me-too
ADMIN_SYSTEM_TOKEN=change-me-admin-token

# ── Admin ──
ADMIN_PHONE=09160684552
ADMIN_BYPASS_CODE=
UNIVERSAL_BYPASS_CODE=

# ── Database (Neon / Postgres) ──
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# ── SMS — Kavenegar ──
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=verify
# اگر true باشد، OTP در پاسخ send برمی‌گردد (فقط توسعه)
SHOW_OTP_IN_DEV=true

# ── AI (DeepSeek / AvalAI) ──
DEEPSEEK_API_KEY=
DEEPSEEK_API_ENDPOINT=https://api.avalai.ir/v1
DEEPSEEK_MODEL=deepseek-chat
AI_TIMEOUT_MS=35000
AI_MAX_TOKENS=4000

# ── Payment — PayPing ──
PAYPING_TOKEN=

# ── Business ──
REFERRAL_PERCENTAGE=10
MIN_WITHDRAWAL=50000
MONTHLY_FREE_LIMIT=2
BLUE_TICK_DAYS=30

# ── CORS (با کاما جدا کنید) ──
ALLOWED_ORIGINS=https://smart-mec-backend-zeta.vercel.app,https://www.smart-mec.ir,https://smart-mec.ir,http://localhost:3000
