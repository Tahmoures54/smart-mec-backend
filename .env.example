# ═══════════════════════════════════════════════════════════
# Smart-MEC Backend — Environment Variables (EXAMPLE)
# Copy to .env and fill real values. NEVER commit .env
# ═══════════════════════════════════════════════════════════

APP_URL=https://your-project.vercel.app
NODE_ENV=production

# Auth (generate strong random strings — min 32 chars)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
COOKIE_SECRET=change-me-too
ADMIN_SYSTEM_TOKEN=change-me-admin-token

# Admin
ADMIN_PHONE=09160684552
ADMIN_BYPASS_CODE=
UNIVERSAL_BYPASS_CODE=

# ── Database (Neon PostgreSQL recommended) ──
# Get connection string from https://console.neon.tech
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# SMS — Kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=verify
SHOW_OTP_IN_DEV=false

# AI (DeepSeek)
DEEPSEEK_API_KEY=
DEEPSEEK_API_ENDPOINT=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
AI_TIMEOUT_MS=55000
AI_MAX_TOKENS=4000

# Payment — PayPing (leave empty for MOCK mode)
PAYPING_TOKEN=

# Business rules
REFERRAL_PERCENTAGE=10
MIN_WITHDRAWAL=50000
MONTHLY_FREE_LIMIT=2

# CORS (comma-separated)
ALLOWED_ORIGINS=https://smart-mec.ir,https://www.smart-mec.ir,http://localhost:3000
